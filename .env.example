# Dataminr (current API)
DATAMINR_CLIENT_ID=
DATAMINR_CLIENT_SECRET=
# DATAMINR_AUTH_URL=https://api.dataminr.com/auth/v1/token
# DATAMINR_ALERTS_URL=https://api.dataminr.com/firstalert/v1/alerts
# DATAMINR_TOKEN_TTL=12600

# Dataminr Legacy API (fallback)
# Set DATAMINR_USE_LEGACY=true to force legacy API
# DATAMINR_USE_LEGACY=false
# DATAMINR_LEGACY_BASE_URL=https://firstalert-api.dataminr.com
# DATAMINR_LEGACY_USER_ID=
# DATAMINR_LEGACY_PASSWORD=
# DATAMINR_ALERT_VERSION=19

# GDACS (public API — no auth required)
# GDACS_BASE_URL=https://www.gdacs.org/gdacsapi
GDACS_COUNTRIES=Sudan,South Sudan,Ethiopia
GDACS_POLL_INTERVAL_MINUTES=30
GDACS_SOURCE_NAME=gdacs

# ACLED (Armed Conflict Location & Event Data Project)
# Get credentials at https://acleddata.com/register/
ACLED_USERNAME=
ACLED_PASSWORD=
# ACLED_BASE_URL=https://acleddata.com
ACLED_COUNTRIES=Sudan
ACLED_POLL_INTERVAL_MINUTES=60
ACLED_SOURCE_NAME=acled

# darfur24.com (public WordPress RSS — no auth required)
# English edition by default; the Arabic primary feed is
# https://darfur24.com/feed/ (both carry the same stories — polling both
# creates near-duplicate signals). Comma-separated.
# DARFUR24_FEED_URLS=https://darfur24.com/en/feed/
DARFUR24_POLL_INTERVAL_MINUTES=30
# Must match the row in clear-api's data_sources table.
DARFUR24_SOURCE_NAME=darfur24

# Redis
REDIS_URL=redis://localhost:6379/0

# CLEAR API
CLEAR_API_URL=http://localhost:4000/graphql
CLEAR_API_KEY=sk_live_...

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Translation stage — pure string-to-string with structure preservation,
# Haiku handles it well at a fraction of Sonnet's cost. Override only if
# you need higher fidelity for a specific locale.
# CLAUDE_MODEL_TRANSLATE=claude-haiku-4-5-20251001

# ─── Translation ─────────────────────────────────────────────────────────────
# Comma-separated BCP-47 codes the pipeline will translate canonical
# English content into (events, crises, locations). 'en' is the canonical
# source and is silently dropped if listed. Leaving this EMPTY disables
# translation entirely — no Claude calls are made and no rows are written.
# That's the safe default until management greenlights the spend.
#
# Launch set: ar,fr. Add fa,ps when Afghanistan goes live.
# TARGET_LOCALES=ar,fr
TARGET_LOCALES=ar,fr

# Nominatim-protocol geocoder (LocationIQ backend).
# Used by the geoparser to resolve landmark names (e.g. "Nyala Airport")
# extracted from signal text into coordinates. Leaving this empty disables
# the geoparser entirely — every lookup returns None and we fall back to
# the source's coords. Same key as clear-api's LOCATIONIQ_API_KEY, but this
# worker has its own environment so it must be set HERE too.
LOCATIONIQ_API_KEY=
# LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1

# Hybrid geoparser (GeoNames gazetteer in clear-api, tier 1 before LocationIQ).
# GEOPARSER_USE_GAZETTEER is the operational kill-switch — it ships DARK
# (false) and must only be flipped to true AFTER clear-api's
# resolveGazetteerLocation resolver is deployed, or every signal logs an error
# before falling back to LocationIQ.
# GEOPARSER_COUNTRY_CODES=sd,ve,af
# GEOPARSER_USE_GAZETTEER=false
# GEOPARSER_GAZETTEER_MIN_SIMILARITY=0.45

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Pipeline settings
POLL_INTERVAL_SECONDS=15
INITIAL_LOOKBACK_DAYS=7
RELEVANCE_THRESHOLD=0.5
DEDUP_TTL_HOURS=48
DATAMINR_SOURCE_NAME=dataminr
MAX_PAGES_PER_POLL=50

# API server (FastAPI for receiving manual signals from clear-api)
API_PORT=8000
# API_SHARED_SECRET=

# Insights dashboard — telemetry for every Claude call
# Repo: github.com/CLEAR-Initiative/clear-pipeline-insights
# Leave INSIGHTS_INGEST_TOKEN empty to disable telemetry entirely.
# PIPELINE_ENV is the tag rows are filed under: 'prod' on Railway, 'staging' on
# the staging deploy, leave empty locally (defaults to 'local-{whoami}').
INSIGHTS_API_URL=https://clear-pipeline-insights.vercel.app
INSIGHTS_INGEST_TOKEN=
# PIPELINE_ENV=prod

# ─── Translation quality eval (scripts/eval_translations.py only) ─────────────
# These are NOT needed by the live pipeline — only by the one-shot
# eval script that translates the last N events with every supported
# model and writes the results to a Notion DB for human grading.
#
# Install the extras first:  pip install -e .[eval]
OPENAI_API_KEY=
# GOOGLE_API_KEY=          # from Google AI Studio (or alias GEMINI_API_KEY)
GEMINI_API_KEY=
NOTION_TOKEN=
# Default target DB created for this eval. Override only if you cloned the
# template into a different Notion workspace.
NOTION_TRANSLATION_DB_ID=
